{
  "name": "MentorTraineeAssignment",
  "type": "object",
  "properties": {
    "mentor_email": {
      "type": "string",
      "description": "Email of the mentor"
    },
    "mentor_name": {
      "type": "string",
      "description": "Full name of the mentor"
    },
    "trainee_email": {
      "type": "string",
      "description": "Email of the trainee"
    },
    "trainee_name": {
      "type": "string",
      "description": "Full name of the trainee"
    },
    "session_number": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 1,
      "description": "Assessment session number"
    },
    "current_ma_session": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 1,
      "description": "Which MA session is currently active for this trainee"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "in_progress",
        "submitted"
      ],
      "default": "upcoming",
      "description": "Assignment status"
    },
    "facility_name": {
      "type": "string",
      "description": "Name of the facility"
    },
    "facility_state": {
      "type": "string",
      "description": "State of the facility"
    },
    "assessment_date": {
      "type": "string",
      "format": "date",
      "description": "Date of assessment"
    },
    "result": {
      "type": "string",
      "enum": [
        "Recommended for Certification",
        "Recommended for Mentored Assessment 2",
        "Recommended for Mentored Assessment 3",
        "Recommended for Mentored Assessment 4",
        "Recommended for Mentored Assessment 5",
        "Recommended for Technical Committee Review",
        "Not Recommended"
      ],
      "description": "Assessment result"
    },
    "result_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the result was submitted"
    },
    "cohort": {
      "type": "string",
      "description": "Cohort identifier"
    },
    "moodle_completion_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started",
      "description": "Moodle course completion status for this trainee"
    }
  },
  "required": [
    "mentor_email",
    "trainee_email"
  ]
}